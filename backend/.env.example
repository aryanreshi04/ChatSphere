# Copy to backend/.env (ignored). Do not put credentials or this .env file into Android.
# Existing Firebase project; private Admin credential stays outside the repository.
FIREBASE_PROJECT_ID=replace-with-your-existing-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/private/chatsphere/service-account.json
HOST=127.0.0.1
PORT=8787
STATE_DATABASE=./runtime/state.sqlite3

# Gemini Developer API: use an UNBILLED free-tier project and review eligibility/data-use terms.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_DAILY_REQUEST_LIMIT=40

# Supabase private bucket. Legacy service_role key is BACKEND ONLY, never in Android.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=chat-media
# Decimal bytes: match Android resource and bucket/global limits. Never exceed Free 50 MB.
MEDIA_MAX_BYTES=50000000

# Optional local-only alternative: set AI_PROVIDER=ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Optional AI_SYSTEM_PROMPT, maximum 4000 characters.
