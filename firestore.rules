rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
    }

    match /users/{userId} {
      // User discovery needs to read profiles after authentication. Keep user
      // documents limited to the public profile fields written by the app.
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      // A signed-in user may check the deterministic ID before the first
      // conversation exists only when their UID is part of the ID. Existing
      // conversations remain participant-only, preventing an existence oracle.
      allow get: if signedIn()
        && (
          (exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in resource.data.participantUids)
          || (!exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid.toUtf8().toHexString().lower() in conversationId.split('__'))
        );
      allow list: if signedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.auth.uid in request.resource.data.participantUids
        && (
          conversationId == request.resource.data.participantUids[0].toUtf8().toHexString().lower() + '__' + request.resource.data.participantUids[1].toUtf8().toHexString().lower()
          || conversationId == request.resource.data.participantUids[1].toUtf8().toHexString().lower() + '__' + request.resource.data.participantUids[0].toUtf8().toHexString().lower()
        )
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantUids[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantUids[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderUid == ''
        && request.resource.data.keys().hasOnly([
          'participantUids', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
        ]);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.keys().hasOnly([
          'participantUids', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
